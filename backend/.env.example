# ──────────────────────────────────────────────────────────────────────────────
# neuraxIA CaseOS — variáveis de ambiente
# Copie este arquivo para .env e preencha com suas chaves reais.
# NUNCA commite o arquivo .env com chaves reais.
# Em produção, use Render Env para runtime e GitHub Secrets apenas para CI/deploy.
# ──────────────────────────────────────────────────────────────────────────────

# === IA / LLMs ===
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AIza...

# === BASES DE DADOS CIENTÍFICAS ===
PUBMED_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
SHERPA_ROMEO_API_KEY=          # disponível após julho/2026

# === E-MAIL TRANSACIONAL ===
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=CaseOS <noreply@caseos.com.br>
POLITE_EMAIL=seu@email.com     # usado em headers de APIs acadêmicas

# === BANCO DE DADOS ===
# Desenvolvimento (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./rccs.db
# Produção (PostgreSQL — Render/Supabase):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/caseos

# === SEGURANÇA JWT ===
SECRET_KEY=troque-por-uma-string-aleatoria-de-64-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=30

# === GOOGLE OAUTH ===
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# === STRIPE ===
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_INST_PRICE_ID=price_...

# === APP ===
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5500
LOG_LEVEL=INFO
MAX_PIPELINE_TIMEOUT=900
MAX_AGENT_TIMEOUT=120
DOCX_OUTPUT_DIR=./docx_output
